# ==============================================================================
# ResearchMate - Environment Configuration Template
# ==============================================================================

# Environment mode ('development' or 'production')
APP_ENV=production

# ------------------------------------------------------------------------------
# Storage Directories (Local fallback / ephemeral mount)
# ------------------------------------------------------------------------------
DATA_PAPERS_DIR=data/papers
DATA_PROCESSED_DIR=data/processed
DATA_CHUNKS_DIR=data/chunks
CHROMA_PERSIST_DIR=data/chroma_db

# ------------------------------------------------------------------------------
# Embedding & Reranker Models (Zero-Cost Local Transformers)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Google Gemini)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# MongoDB Atlas Configuration (Authentication & User Isolation)
# ------------------------------------------------------------------------------
# IMPORTANT: Allow IP 0.0.0.0/0 in MongoDB Atlas -> Network Access
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/ResearchMate?retryWrites=true&w=majority
MONGODB_DB_NAME=ResearchMate

# ------------------------------------------------------------------------------
# Cloudinary Configuration (Cloud PDF & Asset Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Server Port & Host Configuration
# ------------------------------------------------------------------------------
# For FastAPI Server (server.py)
PORT=8000
HOST=0.0.0.0
APP_RELOAD=false

# For Streamlit Interface (app.py)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
